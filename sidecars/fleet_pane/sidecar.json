{
  "command": "node",
  "args": ["--max-old-space-size=20", "--max-semi-space-size=1", "--optimize-for-size", "--jitless", "main.mjs"],
  "restart_policy": "always",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "Fleet",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Fleet"
      }
    ]
  }
}
