// Fleet session policies — loaded by fleet-rs at startup and consulted on
// every session hand-out and live dry-run (`POST /api/policies/test`).
// This file is behaviour, not decoration: the app enforces max_parallel(),
// routes engines/models/timeouts/budgets, attaches default checks and
// file-scope guardrails, and rejects work that fails verification.

/// Maximum number of agent sessions allowed to run at the same time.
/// Sessions handed out beyond this wait in the queue until a slot frees.
pub fn max_parallel() {
    4
}

/// How long (seconds) an agent run or a check may take before the
/// session is handed back as needs-you with the timeout named. A hung
/// agent must never hold its slot — or the operator's attention —
/// forever. Optional: a policy without it gets the app default.
pub fn timeout_secs() {
    1800
}

/// The default model route for OpenCode agent sessions: DeepSeek V4.1 Flash
/// (free tier via OpenCode). Override at startup with FLEET_MODEL or live
/// from the Engines and settings panel. Optional: a policy without it leaves
/// each engine on its own default.
pub fn agent_model() {
    "opencode/deepseek-v4.1-flash-free"
}

/// The verification command for a project when the user did not attach one
/// to the task. A session is only "done" when this command passes in its
/// worktree.
pub fn default_check(project) {
    match project {
        "fixture" => "test -s output.txt",
        "frontend" => "npm test",
        "web" => "npm test",
        "docs" => "true",
        _ => "cargo test",
    }
}

/// Route a task to an engine (`opencode`, `claude`, or `codex`) based on
/// repo/path, task intent, and optional explicit request.
/// Explicit requests (`opencode`, `claude`, `codex`) are always honored.
pub fn route_engine(repo, task, requested_engine) {
    if requested_engine == "opencode" || requested_engine == "claude" || requested_engine == "codex" {
        return requested_engine;
    }

    let r = repo.to_lowercase();
    let t = task.to_lowercase();

    if r.contains("security") || r.contains("audit") || r.contains("infra")
        || t.contains("security") || t.contains("audit") || t.contains("architecture") || t.contains("review")
    {
        return "claude";
    }

    if r.contains("scripts") || r.contains("bench") || r.contains("cli")
        || t.contains("migration") || t.contains("benchmark") || t.contains("shell") || t.contains("script")
    {
        return "codex";
    }

    "opencode"
}

/// Select the default model for a given repo/task/engine route.
/// Keeps the free OpenCode route `opencode/deepseek-v4.1-flash-free` intact.
pub fn route_model(repo, task, engine) {
    match engine {
        "opencode" => agent_model(),
        "claude" => "claude-sonnet-4-5",
        "codex" => "o4-mini",
        _ => "",
    }
}

/// Per-task timeout override (seconds). Long suites and migrations get extra
/// headroom; quick lint/docs jobs fail fast so slots are never wasted.
pub fn timeout_for(repo, task, engine) {
    let t = task.to_lowercase();
    if t.contains("benchmark") || t.contains("migration") || t.contains("full suite") || t.contains("e2e") {
        return 3600;
    }
    if t.contains("lint") || t.contains("format") || t.contains("typo") || t.contains("docs") {
        return 600;
    }
    timeout_secs()
}

/// Maximum automatic retries allowed when a session's check fails before
/// requiring operator intervention. Sensitive tasks never auto-retry.
pub fn auto_retry_budget(repo, task, engine) {
    let t = task.to_lowercase();
    if t.contains("release") || t.contains("deploy") || t.contains("production")
        || t.contains("migration") || t.contains("delete")
    {
        return 0;
    }
    match engine {
        "opencode" => 2,
        "claude" => 1,
        "codex" => 1,
        _ => 1,
    }
}

/// Maximum automatic steering turns permitted per session.
pub fn auto_steer_budget(repo, task, engine) {
    let t = task.to_lowercase();
    if t.contains("release") || t.contains("deploy") || t.contains("production") {
        return 1;
    }
    3
}

/// Default forbidden file globs enforced before any session can mark itself Done.
pub fn forbidden_globs(repo, task) {
    [".env", ".env.*", "**/*.pem", "**/*.key"]
}

/// Optional default allowed file globs. Empty means the whole repository is permitted
/// unless the operator attaches narrower scope rules to the session.
pub fn allowed_globs(repo, task) {
    let t = task.to_lowercase();
    if t.contains("docs-only") || t.contains("docs only") {
        ["**/*.md", "docs/**"]
    } else {
        []
    }
}

/// Optional multi-step check pipeline (`"name::cmd"` entries). Empty falls back
/// to `default_check(project)`.
pub fn check_steps(project, repo) {
    match project {
        "fixture" => ["output::test -s output.txt"],
        _ => [],
    }
}
